#include <stdio.h>
#define INF 100
int n, cost[10][10];
int visited[10] = {0};
int minCost = INF;
void tsp(int city, int count, int total)
{
    int i;

    if(count == n)
    {
        if(cost[city][0] != 0)
        {
            if(total + cost[city][0] < minCost)
                minCost = total + cost[city][0];
        }
        return;
    }

    for(i = 0; i < n; i++)
    {
        if(visited[i] == 0 && cost[city][i] != 0)
        {
            visited[i] = 1;

            tsp(i, count + 1, total + cost[city][i]);

            visited[i] = 0;
        }
    }
}

int main()
{
    int i, j;

    printf("Enter number of cities: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);
        }
    }

    visited[0] = 1;

    tsp(0, 1, 0);

    if(minCost == INF)
        printf("Tour is not possible");
    else
        printf("Minimum travelling cost = %d", minCost);

    return 0;
}
